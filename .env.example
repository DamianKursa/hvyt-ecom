# Domain-based i18n (language determined by hostname)
# Polish: hvyt.pl | English: hvyt.eu
NEXT_PUBLIC_DOMAIN_PL=hvyt.pl
NEXT_PUBLIC_DOMAIN_EN=hvyt.eu

# Full site URLs (used for canonical links and language switcher redirects)
NEXT_PUBLIC_SITE_URL_PL=https://hvyt.pl
NEXT_PUBLIC_SITE_URL_EN=https://hvyt.eu

# Fallback locale when hostname does not match configured domains (e.g. localhost)
NEXT_PUBLIC_DEFAULT_LOCALE=pl

# Maintenance mode — blocks all pages site-wide (HTTP 503)
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Mailchimp — footer newsletter signup (Marketing API)
# API key format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-usXX
MAILCHIMP_API_KEY=
# Audience / List ID from Mailchimp → Audience → Settings
MAILCHIMP_AUDIENCE_ID=
# Optional: set to "true" to require confirmation email (double opt-in)
MAILCHIMP_DOUBLE_OPT_IN=false
